# Build stage
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY contracts/ contracts/
COPY bff/Sigmap.Bff/Sigmap.Bff.csproj bff/Sigmap.Bff/
RUN dotnet restore bff/Sigmap.Bff/Sigmap.Bff.csproj

COPY bff/ bff/
RUN dotnet publish bff/Sigmap.Bff/Sigmap.Bff.csproj -c Release -o /app/publish

# Runtime stage
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app
COPY --from=build /app/publish .
EXPOSE 8080
ENTRYPOINT ["dotnet", "Sigmap.Bff.dll"]
