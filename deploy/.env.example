# Copy to .env (repo root) and adjust. All variables have dev defaults, so
# these are only needed to override them.

POSTGRES_PASSWORD=sigmap
RABBITMQ_PASSWORD=sigmap

# Backend pairing QR token (encoded in the QR code shown on the Pairing page).
PAIRING_TOKEN=sigmap-dev-token
# Host that paired devices will dial (as printed in the pairing QR).
PUBLIC_HOST=http://localhost:5080

# BFF auth (roles: operator / viewer).
AUTH__OPERATOR_USERNAME=operator
AUTH__OPERATOR_PASSWORD=sigmap-dev
AUTH__VIEWER_USERNAME=viewer
AUTH__VIEWER_PASSWORD=viewer-dev

# Backend retention (days) and client-MAC anonymization.
RETENTION__DETECTIONSDAYS=365
RETENTION__ANONYMIZECLIENTMACS=false

# Frontend gRPC-Web target (dev container uses host-mapped BFF port).
VITE_BFF_URL=http://localhost:5090

# Production web port (docker-compose.prod.yml).
WEB_PORT=8080
