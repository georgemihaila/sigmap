{
  "name": "sigmap-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "gen:proto": "protoc --plugin=protoc-gen-es=./node_modules/.bin/protoc-gen-es --es_out src/generated --es_opt target=ts --plugin=protoc-gen-connect-es=./node_modules/.bin/protoc-gen-connect-es --connect-es_out src/generated --connect-es_opt target=ts --proto_path ../contracts/proto ../contracts/proto/*.proto",
    "test": "vitest"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^1.10.0",
    "@connectrpc/connect": "^1.4.0",
    "@connectrpc/connect-web": "^1.4.0",
    "@mantine/core": "^7.10.0",
    "@mantine/hooks": "^7.10.0",
    "@reduxjs/toolkit": "^2.2.3",
    "leaflet": "^1.9.4",
    "qrcode.react": "^3.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-redux": "^9.1.0",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^1.10.0",
    "@connectrpc/protoc-gen-connect-es": "^1.4.0",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^15.0.7",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^26.2.0",
    "@types/qrcode.react": "^1.0.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^24.1.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.13",
    "vitest": "^1.6.0"
  }
}
